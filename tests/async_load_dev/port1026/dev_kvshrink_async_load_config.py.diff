 """Configuration policy for KVShrink asynchronous KV loading."""
 
+import enum
 import logging
 import os
 from collections.abc import Mapping
@@ -12,6 +13,92 @@ from typing import Optional
 logger = logging.getLogger(__name__)
 
 
+class AsyncLoadScheme(str, enum.Enum):
+    """How async KV loads are submitted to and ordered in the load queue."""
+
+    # Each async request submits all layers with its own get() call.
+    NAIVE = "naive"
+    # Async requests of one step share one get() call, one task per layer.
+    BATCH_REQS_ASYNC_LOAD_SUBMIT = "batch_reqs_async_load_submit"
+    # Submit the first N layers, then the remaining layers after promotion. The
+    # first N layers of one step's requests share one get() per layer segment.
+    SPLIT_ASYNC_LOAD_SUBMIT_FIRST_N_BATCH_REQS = "split_async_load_submit_first_n_batch_reqs"
+    # Same, but each request's first N layers use their own get(), in arrival order.
+    SPLIT_ASYNC_LOAD_SUBMIT_FIRST_N_PER_REQ = "split_async_load_submit_first_n_per_req"
+    # Submit all layers in one get() per request: first N layers at level P1, the
+    # rest at P2; the request's group is raised to P0 when a forward first waits
+    # on it.
+    PRIORITY_3LEVEL_FIRST_N_PER_REQ = "priority_3level_first_n_per_req"
+    # Same as PRIORITY_3LEVEL_FIRST_N_PER_REQ, but the remaining layers are raised to
+    # P0 when the request is promoted instead of when a forward first waits on it.
+    PRIORITY_3LEVEL_FIRST_N_PER_REQ_PROMOTE_RAISE = (
+        "priority_3level_first_n_per_req_promote_raise"
+    )
+    # Same as PRIORITY_3LEVEL_FIRST_N_PER_REQ, but the groups of all requests a
+    # forward first waits on and the group of that step's sync batch are raised in
+    # one call that orders their waiting tasks in P0 by layer.
+    PRIORITY_3LEVEL_FIRST_N_PER_REQ_REMAINING_BY_LAYER = (
+        "priority_3level_first_n_per_req_remaining_by_layer"
+    )
+    # Same as PRIORITY_3LEVEL_FIRST_N_PER_REQ_REMAINING_BY_LAYER, but the first N
+    # layers of one step's requests share one get() per layer segment at P1; each
+    # request's remaining layers use their own get() at P2.
+    PRIORITY_3LEVEL_FIRST_N_BATCH_REQS_REMAINING_BY_LAYER = (
+        "priority_3level_first_n_batch_reqs_remaining_by_layer"
+    )
+    # Split submission with two fixed priorities; each level FIFO.
+    SPLIT_PRIORITY_2LEVEL = "split_priority_2level"
+
+
+IMPLEMENTED_ASYNC_LOAD_SCHEMES = frozenset(
+    {
+        AsyncLoadScheme.NAIVE,
+        AsyncLoadScheme.BATCH_REQS_ASYNC_LOAD_SUBMIT,
+        AsyncLoadScheme.SPLIT_ASYNC_LOAD_SUBMIT_FIRST_N_BATCH_REQS,
+        AsyncLoadScheme.SPLIT_ASYNC_LOAD_SUBMIT_FIRST_N_PER_REQ,
+        AsyncLoadScheme.PRIORITY_3LEVEL_FIRST_N_PER_REQ,
+        AsyncLoadScheme.PRIORITY_3LEVEL_FIRST_N_PER_REQ_PROMOTE_RAISE,
+        AsyncLoadScheme.PRIORITY_3LEVEL_FIRST_N_PER_REQ_REMAINING_BY_LAYER,
+        AsyncLoadScheme.PRIORITY_3LEVEL_FIRST_N_BATCH_REQS_REMAINING_BY_LAYER,
+    }
+)
+
+
+def parse_async_load_scheme(value: str) -> AsyncLoadScheme:
+    """Parse ``KVSHRINK_ASYNC_LOAD_SCHEME``.
+
+    Raises:
+        ValueError: the value is not a scheme name, or the scheme is not
+            implemented yet.
+    """
+    try:
+        scheme = AsyncLoadScheme(value.strip())
+    except ValueError as error:
+        raise ValueError(
+            "KVSHRINK_ASYNC_LOAD_SCHEME must be one of "
+            f"{[s.value for s in AsyncLoadScheme]}, got {value!r}"
+        ) from error
+    if scheme not in IMPLEMENTED_ASYNC_LOAD_SCHEMES:
+        raise ValueError(
+            f"KVSHRINK_ASYNC_LOAD_SCHEME={scheme.value} is not implemented yet"
+        )
+    return scheme
+
+
+def load_async_load_scheme_from_env(
+    environ: Mapping[str, str] | None = None,
+) -> AsyncLoadScheme:
+    """Load ``KVSHRINK_ASYNC_LOAD_SCHEME`` exported by ``setvars.sh``."""
+    source = os.environ if environ is None else environ
+    value = source.get("KVSHRINK_ASYNC_LOAD_SCHEME")
+    if not value:
+        raise ValueError(
+            "KVSHRINK_ASYNC_LOAD_SCHEME must be set; source setvars.sh before "
+            "starting vLLM"
+        )
+    return parse_async_load_scheme(value)
+
+
 @dataclass(frozen=True)
 class AsyncLoadLayerConfig:
     """Select the number of leading KV layers required before prefill."""

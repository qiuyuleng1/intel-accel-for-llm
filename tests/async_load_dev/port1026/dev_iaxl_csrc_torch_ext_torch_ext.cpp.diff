+        [](const std::string &queue) {
+            TaskQueue &q = task_queue_by_name(queue);
+            std::vector<TaskTraceEvent> events;
+            uint64_t dropped;
+            {
+                py::gil_scoped_release release;
+                events = q.drain_trace();
+                dropped = q.trace_dropped();
+                q.reset_trace_dropped();
+            }
+            py::list py_events;
+            for (const auto &e : events) {
+                py::dict d;
+                d["label"] = e.label;
+                d["priority"] = e.priority;
+                d["submit_priority"] = e.submit_priority;
+                d["group"] = e.group;
+                d["order_key"] = e.order_key;
+                d["seq"] = e.seq;
+                d["enqueue_ns"] = e.enqueue_ns;
+                d["p0_enter_ns"] = e.p0_enter_ns;
+                d["start_ns"] = e.start_ns;
+                d["end_ns"] = e.end_ns;
+                d["release_ns"] = e.release_ns;
+                py::list depth;
+                for (uint32_t n : e.depth)
+                    depth.append(n);
+                d["depth"] = depth;
+                py_events.append(d);
+            }
+            py::dict d;
+            d["queue"] = queue;
+            d["enabled"] = q.trace_enabled();

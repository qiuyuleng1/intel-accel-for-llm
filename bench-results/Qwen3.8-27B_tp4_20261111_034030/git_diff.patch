diff --git a/examples/kvshrink-vllm-serve.sh b/examples/kvshrink-vllm-serve.sh
index 5ec97c2..c1f5925 100755
--- a/examples/kvshrink-vllm-serve.sh
+++ b/examples/kvshrink-vllm-serve.sh
@@ -16,13 +16,27 @@ device_args=(--gpu-memory-utilization 0.8)
 [[ "$DEVICE" == cpu ]] && device_args=()
 # Unset BLOCK_SIZE keeps vLLM's default: 128 on CPU (16 for MLA models), 16 or the attention backend's preference on GPU.
 [[ -n "$BLOCK_SIZE" ]] && device_args+=(--block-size "$BLOCK_SIZE")
+# Unset CUDAGRAPH_MODE keeps vLLM's choice: FULL_AND_PIECEWISE, or PIECEWISE when the KV connector requires it.
+[[ -n "$CUDAGRAPH_MODE" ]] && device_args+=(--compilation-config "{\"cudagraph_mode\": \"$CUDAGRAPH_MODE\"}")
+# TORCH_PROFILER_DIR enables vLLM's torch profiler: POST /start_profile records
+# PROFILER_MAX_ITERATIONS worker steps, then it stops and writes its trace and
+# profiler_out_<rank>.txt (CUDA time per kernel) into that directory.
+[[ -n "$TORCH_PROFILER_DIR" ]] && device_args+=(--profiler-config "{\"profiler\": \"torch\", \"torch_profiler_dir\": \"$TORCH_PROFILER_DIR\", \"torch_profiler_with_stack\": false, \"max_iterations\": ${PROFILER_MAX_ITERATIONS:-20}}")
+
+# Benchmark baselines: BASELINE=no_cache is plain vLLM without KV reuse,
+# BASELINE=prefix_cache is plain vLLM with its GPU prefix cache.
+# GPU_PREFIX_CACHING=1 keeps vLLM's GPU prefix cache on next to KVShrink.
+kvshrink_prefix_caching_arg=--no-enable-prefix-caching
+[[ "$GPU_PREFIX_CACHING" == 1 ]] && kvshrink_prefix_caching_arg=--enable-prefix-caching
+cache_args=(--kv-transfer-config '{"kv_connector":"KVShrinkConnector","kv_connector_module_path":"kvshrink.kvshrink_connector","kv_role":"kv_both"}' "$kvshrink_prefix_caching_arg")
+[[ "$BASELINE" == no_cache ]] && cache_args=(--no-enable-prefix-caching)
+[[ "$BASELINE" == prefix_cache ]] && cache_args=(--enable-prefix-caching)
 
 vllm serve "$MODEL" \
-    --kv-transfer-config '{"kv_connector":"KVShrinkConnector","kv_connector_module_path":"kvshrink.kvshrink_connector","kv_role":"kv_both"}' \
+    "${cache_args[@]}" \
     --trust-remote-code \
     "${parallel_args[@]}" \
     "${device_args[@]}" \
     --max-model-len "${MAX_MODEL_LEN:-32765}" \
     --port "${PORT:-8000}" \
-    --no-enable-prefix-caching \
     2>&1 | tee log.kvshrink-vllm
diff --git a/setvars.sh b/setvars.sh
index 45a618f..6284060 100644
--- a/setvars.sh
+++ b/setvars.sh
@@ -1,6 +1,6 @@
 export IAXL_VERSION=${IAXL_VERSION:-1.6.0}
 export IAXL_BASE_DOCKER_IMAGE=${IAXL_BASE_DOCKER_IMAGE:-"vllm/vllm-openai:v0.29.0"}
-export IAXL_DEV_DOCKER_IMAGE=${IAXL_DEV_DOCKER_IMAGE:-"vllm-iaxl-dev:$IAXL_VERSION"}
+export IAXL_DEV_DOCKER_IMAGE=${IAXL_DEV_DOCKER_IMAGE:-"vllm-iaxl-dev-fddeef0-qiuyu:$IAXL_VERSION"}
 export IAXL_BUILDER_DOCKER_IMAGE=${IAXL_BUILDER_DOCKER_IMAGE:-"vllm-iaxl-builder"}
 
 TOP_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
@@ -22,9 +22,9 @@ export NVIDIA_RUNTIME=${NVIDIA_RUNTIME:-}     # Set to "none" to skip the nvidia
 # ---- Feature switches -------------------------------------------------------
 export IAXL_KV_COMPRESSION=${IAXL_KV_COMPRESSION:-1} # Enable DEFLATE compression (0/1)
 export IAXL_QAT_ZIP_ENABLE=${IAXL_QAT_ZIP_ENABLE:-1} # Enable QAT compression workers (0/1)
-export IAXL_IAA_ZIP_ENABLE=${IAXL_IAA_ZIP_ENABLE:-0} # Enable IAA (QPL) compression workers (0/1)
+export IAXL_IAA_ZIP_ENABLE=${IAXL_IAA_ZIP_ENABLE:-1} # Enable IAA (QPL) compression workers (0/1)
 export IAXL_CPU_ZIP_ENABLE=${IAXL_CPU_ZIP_ENABLE:-0} # Enable CPU compression workers (0/1); costs a lot of CPU, keep off unless needed
-export IAXL_DSA_GD_ENABLE=${IAXL_DSA_GD_ENABLE:-0}   # Use Intel DSA + GDRCopy transfers (0/1)
+export IAXL_DSA_GD_ENABLE=${IAXL_DSA_GD_ENABLE:-1}   # Use Intel DSA + GDRCopy transfers (0/1)
 
 # ---- Async KV load ----------------------------------------------------------
 export KVSHRINK_VLLM_KV_ASYNC_LOAD_ENABLED=${KVSHRINK_VLLM_KV_ASYNC_LOAD_ENABLED:-1}      # Enable asynchronous KV loading (0/1)
@@ -34,7 +34,7 @@ export KVSHRINK_VLLM_KV_ASYNC_LOAD_LAYERS_DYNAMIC_MAP="${KVSHRINK_VLLM_KV_ASYNC_
 
 # ---- vLLM ------------------------------------------------------------------
 export MODEL="${MODEL:-Qwen/Qwen3-32B}" # Hugging Face model ID or local model path
-export TP_SIZE="${TP_SIZE:-2}"            # Tensor-parallel worker count
+export TP_SIZE="${TP_SIZE:-8}"            # Tensor-parallel worker count
 export DP_SIZE="${DP_SIZE:-1}"            # Data-parallel group count
 # Total workers = one per (dp, tp) pair; CPU/QAT/DSA specs are indexed per worker.
 NUM_WORKERS=$((TP_SIZE * DP_SIZE))
@@ -111,7 +111,7 @@ export IAXL_DDR_POOL_EVICT_INTERVAL_S=${IAXL_DDR_POOL_EVICT_INTERVAL_S:-30}
 
 # ---- Intel QAT (compression accelerator) ------------------------------------
 export IAXL_QAT_DEVICES=${IAXL_QAT_DEVICES:-0}                                   # Comma-separated QAT device indices, e.g. "0,1"
-export IAXL_QAT_ZIP_INSTANCES_PER_DEVICE=${IAXL_QAT_ZIP_INSTANCES_PER_DEVICE:-4} # Instances (driving threads) per device
+export IAXL_QAT_ZIP_INSTANCES_PER_DEVICE=${IAXL_QAT_ZIP_INSTANCES_PER_DEVICE:-8} # Instances (driving threads) per device
 # QAT driving threads = number of devices x instances-per-device (override to force).
 case "${IAXL_QAT_ZIP_ENABLE,,}" in
     1|true|yes|on)
@@ -200,7 +200,7 @@ export http_proxy="${http_proxy:-}"
 export https_proxy=$http_proxy
 
 # docker
-CONTAINER_NAME=iaxl.vllm
+CONTAINER_NAME=iaxl.vllm-fddeef0-qiuyu
 ENV_VARS=(
     no_proxy
     http_proxy
@@ -243,8 +243,15 @@ DOCKER_RUN_ARGS+=("-v" "$PWD/_data:/_data")
 if [[ -d /run/qat ]]; then
     DOCKER_RUN_ARGS+=("-v" "/run/qat:/run/qat")
 fi
+# Mount the whole model space, so one container can serve any model in it.
+MODEL_SPACE=/home/intel/model-space
+if [[ -d "$MODEL_SPACE" ]]; then
+    DOCKER_RUN_ARGS+=("-v" "$MODEL_SPACE:$MODEL_SPACE:ro")
+fi
 if [[ -d "$MODEL" ]]; then
     MODEL_DIR=$(realpath "$MODEL")
-    DOCKER_RUN_ARGS+=("-v" "$MODEL_DIR:$MODEL_DIR:ro")
+    if [[ "$MODEL_DIR" != "$MODEL_SPACE"/* ]]; then
+        DOCKER_RUN_ARGS+=("-v" "$MODEL_DIR:$MODEL_DIR:ro")
+    fi
 fi
 DOCKER_RUN_ARGS+=("-v" "$PWD:$PWD" "-w" "$PWD")
diff --git a/tools/setup_qat.sh b/tools/setup_qat.sh
index 09ce3e1..a04c01f 100755
--- a/tools/setup_qat.sh
+++ b/tools/setup_qat.sh
@@ -5,7 +5,7 @@
 #
 # - ServicesEnabled = dc: with a second service (e.g. asym;dc) a QAT 2.0 device splits its
 #   8 engines 4|4, leaving compression only half. Crypto instances and Kpt* keys are removed.
-# - [SSL] NumProcesses = 4, NumberDcInstances = 8: up to 4 processes (e.g. TP ranks) share
+# - [SSL] NumProcesses = 8, NumberDcInstances = 8: up to 8 processes (e.g. TP ranks) share
 #   QAT, each with 8 instances per device. dc-only allows at most 64 instances per device.
 # - Dc CoreAffinity: CPUs of the device's own NUMA node, different CPUs for each device.
 # - SVMEnabled/ATEnabled: set only when the kernel runs with iommu=on or iommu=pt.
@@ -39,7 +39,7 @@ fi
 TMP=$(mktemp)
 trap 'rm -f "$TMP"' EXIT
 
-SSL_NUM_PROCESSES=4
+SSL_NUM_PROCESSES=8
 SSL_NUM_DC_INSTANCES=8
 echo "Setting [SSL] NumProcesses = $SSL_NUM_PROCESSES, NumberDcInstances = $SSL_NUM_DC_INSTANCES"
 echo "Setting ServicesEnabled = dc (sym/asym crypto and their instances are removed)"
